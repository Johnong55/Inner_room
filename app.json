{
  "expo": {
    "name": "InnerRoom",
    "slug": "innerroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "innerroom",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#091111",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.innerroom.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "InnerRoom dùng Face ID để bảo vệ không gian riêng của bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#091111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.innerroom.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#091111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "InnerRoom dùng Face ID để bảo vệ không gian riêng của bạn."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "InnerRoom dùng Face ID để bảo vệ không gian riêng của bạn."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#789387"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
